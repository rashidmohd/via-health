# Static PWA with strict security headers. API_ORIGIN is set on the Railway `web` service.
{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' {$API_ORIGIN}; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Content-hashed or versioned paths never change.
	@hashed path /assets/* /live-stt/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Fixed names that change with each deploy: always revalidate (CDN and browser).
	@unversioned path /live-stt-worker.js /live-stt-capture.js /favicon.svg
	header @unversioned Cache-Control "no-cache"

	# Requests for files (anything with an extension) never fall back to the app page:
	# a missing file is a 404, which no cache will keep serving as if it were code.
	@file path_regexp \.[A-Za-z0-9]+$
	handle @file {
		file_server
	}

	# Errors (e.g. a missing file) must never be cached, whatever the path.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}

	# App routes (/clients, /sessions/…) get the app page, never cached.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
