# Names only. Never commit real values.
APP_ENV=dev
DATABASE_URL=
REDIS_URL=
WEB_ORIGIN=
GCP_PROJECT_ID=
GCP_REGION=europe-west4
# Railway: the key JSON as text. Locally use GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json instead.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# postgres|gcs, local|gcp, fake|google — staging/prod require gcs, gcp, google (plan 0005)
OBJECT_STORE=postgres
KMS_PROVIDER=local
STT_PROVIDER=fake
STT_LOCATION=eu
GCS_BUCKET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
KMS_KEY_NAME=
STT_MODEL=chirp_3
LLM_PROVIDER=gemini_api   # prod: vertex (ADR 0005)
LLM_MODEL=
AUDIO_MAX_RETENTION_DAYS=30
# Login (ADR 0003)
AUTH_SECRET=
EMAIL_SENDER=console
RESEND_API_KEY=
EMAIL_FROM=
# ADR 0019: test account with a fixed 6-digit code, no email sent. Leave empty to turn off; refused in prod.
TEST_LOGIN_EMAIL=test@sessio.io
TEST_LOGIN_CODE=123123
# ADR 0004: interim key for client data, 64 hex chars (openssl rand -hex 32)
CLIENT_DATA_KEY=
